{
  "name": "pnm-tracking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "seed:admin": "node scripts/seedAdmin.mjs",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:rules": "firebase emulators:exec --only firestore --project pnm-rules-test \"vitest run tests/rules.test.ts\"",
    "emulators": "firebase emulators:start --project demo-pnm",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "vitest run tests/reminders.test.ts tests/import.test.ts tests/importInput.test.ts",
    "deploy:functions": "firebase deploy --only functions",
    "import:pnms": "node scripts/importPnms.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^13.0.1",
    "firebase-tools": "^15.29.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.0"
  }
}

# Firebase web config — copy to .env and fill in from
# Firebase console > Project settings > Your apps > Web app > SDK setup.
# These are client-side identifiers, not secrets; access is controlled by
# Firestore security rules. Still kept out of git so the repo isn't tied to
# one project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair (Cloud Messaging > Web configuration).
# Not used until Phase 3 (reminders); leave blank for now.
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to point the app at the local Firebase Emulator Suite.
VITE_USE_EMULATORS=false
